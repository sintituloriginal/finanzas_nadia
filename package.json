{
  "name": "mi-presupuesto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicación web full-stack de finanzas personales en CLP con Vue 3, Quasar 2, TypeScript y Supabase",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@supabase/supabase-js": "^2.49.1",
    "echarts": "^5.6.0",
    "pinia": "^3.0.1",
    "quasar": "^2.17.7",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.9.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.0.0",
    "sass-embedded": "^1.85.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6",
    "vue-tsc": "^2.2.2"
  }
}

